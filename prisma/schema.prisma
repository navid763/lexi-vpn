generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}


model User {
  id             Int           @id @default(autoincrement())
  chatId         String        @unique @map("chat_id")
  messengerType  String        @default("bale") @map("messenger_type")
  username       String?
  fullName       String?       @map("full_name")
  isAdmin        Boolean       @default(false) @map("is_admin")
  balance        Int           @default(0)
  referralCode   String        @unique @map("referral_code")
  invitedById    Int?          @map("invited_by")

  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  referrer       User?         @relation("Referrals", fields: [invitedById], references: [id])
  referrals      User[]        @relation("Referrals")

  orders         Order[]
  payments       Payment[]
  subscriptions  Subscription[]

  @@map("users")
}

model Product {
  id            Int       @id @default(autoincrement())
  name          String
  price         Int
  trafficLimit  Int       @map("traffic_limit")
  durationDays  Int       @map("duration_days")
  isActive      Boolean   @default(true) @map("is_active")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  orders        Order[]

  @@map("products")
}

model Order {
  id                     Int           @id @default(autoincrement())
  userId                 Int           @map("user_id")
  productId              Int           @map("product_id")
  price                  Int
  type                   OrderType     @default(NEW_ORDER)
  status                 OrderStatus   @default(PENDING_PAYMENT)
  receiptImage           String?       @map("receipt_image")
  adminNote              String?       @map("admin_note")
  // For renewal orders: which subscription is being extended
  renewalSubscriptionId  Int?          @map("renewal_subscription_id")

  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")
  deletedAt              DateTime?     @map("deleted_at")

  user                   User          @relation(fields: [userId], references: [id])
  product                Product       @relation(fields: [productId], references: [id])
  renewalSubscription    Subscription? @relation("RenewalOrders", fields: [renewalSubscriptionId], references: [id])
  payment                Payment?
  subscription           Subscription? @relation("SubscriptionOrder")

  @@map("orders")
}

enum OrderType {
  NEW_ORDER  @map("new_order")
  RENEWAL    @map("renewal")
}

enum OrderStatus {
  PENDING_PAYMENT   @map("pending_payment")
  WAITING_APPROVAL  @map("waiting_approval")
  APPROVED          @map("approved")
  REJECTED          @map("rejected")
  CANCELLED         @map("cancelled")
}

model Payment {
  id               Int           @id @default(autoincrement())
  userId           Int           @map("user_id")
  orderId          Int?          @unique @map("order_id")
  amount           Int
  type             PaymentType   @default(ORDER_PAYMENT)
  receiptImage     String?       @map("receipt_image")
  destinationCard  String?       @map("destination_card")
  status           PaymentStatus @default(PENDING)

  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")

  user             User          @relation(fields: [userId], references: [id])
  order            Order?        @relation(fields: [orderId], references: [id])

  @@map("payments")
}

enum PaymentType {
  ORDER_PAYMENT  @map("order_payment")
  WALLET_TOPUP   @map("wallet_topup")
}

enum PaymentStatus {
  PENDING    @map("pending")
  APPROVED   @map("approved")
  REJECTED   @map("rejected")
  CANCELLED  @map("cancelled")
}

model Server {
  id         Int      @id @default(autoincrement())
  name       String
  host       String
  panelType  String?  @map("panel_type")
  isActive   Boolean  @default(true) @map("is_active")

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  subscriptions Subscription[]

  @@map("servers")
}

model Subscription {
  id            Int                @id @default(autoincrement())
  userId        Int                @map("user_id")
  orderId       Int                @unique @map("order_id")
  serverId      Int                @map("server_id")
  trafficLimit  Int                @map("traffic_limit")
  expireAt      DateTime           @map("expire_at")
  status        SubscriptionStatus @default(ACTIVE)

  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  deletedAt     DateTime?          @map("deleted_at")

  user          User               @relation(fields: [userId], references: [id])
  order         Order              @relation("SubscriptionOrder", fields: [orderId], references: [id])
  server        Server             @relation(fields: [serverId], references: [id])
  config        Config?
  // Renewal orders that reference this subscription
  renewalOrders Order[]            @relation("RenewalOrders")

  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE    @map("active")
  EXPIRED   @map("expired")
  CANCELLED @map("cancelled")
}

model Config {
  id             Int          @id @default(autoincrement())
  subscriptionId Int          @unique @map("subscription_id")
  uuid           String
  configUrl      String       @map("config_url")

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  subscription   Subscription @relation(fields: [subscriptionId], references: [id])

  @@map("configs")
}
